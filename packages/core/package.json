{
  "name": "@dossier/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared PDF operations. Environment-agnostic, used by both the web app and the MCP server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings=0 --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@hyzyla/pdfium": "2.1.12",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.7.284",
    "tesseract.js": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
