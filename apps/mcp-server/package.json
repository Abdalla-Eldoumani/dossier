{
  "name": "@dossier/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing Dossier's PDF operations to AI agents.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "dossier-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0 --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@dossier/core": "*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "eslint": "9.39.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
